filters:
  and:
    - file.inFolder("reading")
    - type == "reading"

properties:
  file.name:
    displayName: Title
  description:
    displayName: Takeaway
  source_type:
    displayName: Source
  status:
    displayName: Status
  finished:
    displayName: Finished
  rating:
    displayName: Rating
  via:
    displayName: Found via

views:
  - type: table
    name: All Reading
    order:
      - file.name
      - description
      - source_type
      - status
      - finished
      - rating
      - via
    sort:
      - property: finished
        direction: DESC
    columnSize:
      file.name: 260
      description: 380

  - type: cards
    name: Cards
    order:
      - file.name
      - description
      - source_type
      - finished
      - rating
    cardSize: 240
