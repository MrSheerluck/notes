filters:
  and:
    - file.inFolder("reading")
    - type == "reading"

properties:
  file.name:
    displayName: Title
  source_type:
    displayName: Source
  status:
    displayName: Status
  url:
    displayName: URL

views:
  - type: table
    name: All Reading
    order:
      - file.name
      - source_type
      - status
      - url
    sort:
      - property: finished
        direction: DESC
    columnSize:
      file.name: 300
      url: 420
